---
import Base from "../layouts/Base.astro";
import DeliveryLoop from "../components/DeliveryLoop.astro";
import { CLASSIFICATION_LABELS, framework, sentence, totals } from "../lib/catalog";

const categories = [...new Set(framework.skills.map((s) => s.category))].map((name) => ({
  name,
  skills: framework.skills.filter((s) => s.category === name),
}));
const countBy = (c: string) => framework.skills.filter((s) => s.classification === c).length;

// Lowercase a leading word unless it's an acronym, like "UAT sign-off".
const lowerFirst = (s: string) => (/^[A-Z][a-z]/.test(s) ? s.charAt(0).toLowerCase() + s.slice(1) : s);
// Non-breaking hyphen so "AI-DLC" never splits across lines.
const keepTogether = (s: string) => s.replace(/AI-DLC/g, "AI\u2011DLC");

const CORE = new Set(["Onboarding", "Experience", "Diagnostics"]);

const forces = {
  maximize: [
    {
      name: "Value flow",
      how: "Work moves in small, bounded bolts, each mapped to one intent, with ceremony sized to the risk.",
    },
    {
      name: "Feedback",
      how: "A retro only counts once its improvement has changed a rule, and estimates recalibrate from recorded hours.",
    },
  ],
  minimize: [
    {
      name: "Ambiguity",
      how: "Intents carry Given/When/Then acceptance criteria and explicit scope, and contracts are locked before building.",
    },
    {
      name: "Unnecessary effort",
      how: "Bug and hotfix bolts take a lighter path, and shared rules are written once and reused, never restated.",
    },
    {
      name: "Unmanaged risk",
      how: "Every intent is risk-classified, and every bolt has a blast-radius, rollback and feature-flag decision first.",
    },
  ],
};

const entryPoints = [
  {
    id: "onboard",
    title: "Onboard a project",
    when: "Install the full framework. Works for new projects through an interview, and for mature ones through codebase archaeology.",
    copy: ["process-onboarding-agent/"],
    say: "Read process-onboarding-agent/onboard.md and follow the instructions inside it.",
    then: "Review the completion report, close the session, and from the next session say “Run a mob elaboration for [first intent name]”.",
  },
  {
    id: "diagnose",
    title: "Run a diagnostic review",
    when: "Audit how a team delivers today against AI-DLC principles. No installation needed.",
    copy: ["process-diagnostic-agent/"],
    say: "Read process-diagnostic-agent/role-play.md and follow the instructions inside it.",
  },
  {
    id: "skills",
    title: "Add skills to your own process",
    when: "Pick individual skills for a bespoke delivery process without installing the whole framework.",
    copy: ["process-skills-agent/", "process-onboarding-agent/"],
    say: "Read process-skills-agent/onboard.md and follow the instructions inside it.",
  },
  {
    id: "estimate",
    title: "Produce an estimate",
    when: "Mode 1 gives a ballpark range from draft requirements. Mode 2 gives bolt-level estimates once elaboration is done.",
    copy: ["process-estimation-agent/"],
    say: "Read process-estimation-agent/estimate.md and follow the instructions inside it.",
  },
];
---

<Base
  title="Intent Delivery Framework"
  current="framework"
  description="The 99x Intent Delivery Framework: how a team and its AI work together, from written intent to production and back, in Claude Code, Cursor or GitHub Copilot."
>
  <section class="intro">
    <div class="wrap intro-grid">
      <div class="intro-copy">
        <p class="lib framework">Intent Delivery Framework</p>
        <h1>Every feature starts with a written intent.</h1>
        <p class="lede">
          The delivery operating system inside 99x’s AI-DLC methodology: files, conventions and ceremonies that govern how a team
          and its AI work together. It installs through a conversation with your team, so the rules it writes are your own.
        </p>
        <div class="actions">
          <a class="button" href="#start">Get started</a>
          <a class="button ghost" href="#skills">Browse the {totals.frameworkSkills} skills</a>
        </div>
      </div>
      <div class="outcome">
        <p class="outcome-title">What you end up with</p>
        <ul>
          <li>Every feature starts with a written intent and testable acceptance criteria.</li>
          <li>Every AI interaction passes a quality gate and is logged for audit.</li>
          <li>Every failure feeds back into rules that stop it recurring.</li>
          <li>Any engineer, or AI tool, opening the repository knows exactly how to work in it.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="loop-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="loop-title">Delivery as a loop, not a project</h2>
        <p class="lede">
          Work moves from Inception to Build to Operate, and what the team learns becomes improvements that shape the next
          Inception. These skills carry the work through each stage.
        </p>
      </div>
      <DeliveryLoop show="framework" />
    </div>
  </section>

  <section class="section" id="agents" aria-labelledby="agents-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="agents-title">The agent suite</h2>
        <p class="lede">
          Three core agents install, run and audit the framework. Three supporting agents cover partial adoption, migration and
          estimation.
        </p>
      </div>
      <ul class="suite">
        {
          framework.agents.map((a) => (
            <li class:list={["suite-row", { core: CORE.has(a.name) }]}>
              <div class="suite-name">
                <h3>{a.name}</h3>
                <span class="chip">{CORE.has(a.name) ? "Core" : "Supporting"}</span>
              </div>
              <p>{sentence(a.does)}</p>
              <p class="entry">
                <span>Starts from</span>
                <code>{a.entryPoint}</code>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section objective" aria-labelledby="objective-title">
    <div class="wrap">
      <h2 id="objective-title" class="visually-hidden">The founding objective</h2>
      <blockquote>
        <p>Maximize value flow and feedback. Minimize ambiguity, unnecessary effort, and unmanaged risk.</p>
        <footer>The objective every mechanism in the framework answers to</footer>
      </blockquote>
      <div class="forces">
        <div>
          <h3>Maximize</h3>
          <dl>
            {
              forces.maximize.map((f) => (
                <div>
                  <dt>{f.name}</dt>
                  <dd>{f.how}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div>
          <h3>Minimize</h3>
          <dl>
            {
              forces.minimize.map((f) => (
                <div>
                  <dt>{f.name}</dt>
                  <dd>{f.how}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
      <p class="values-link">
        <a href={`${framework.url}/blob/main/framework-values.md`}>Read how each force maps to the framework’s mechanisms</a>
      </p>
    </div>
  </section>

  <section class="section" id="skills" aria-labelledby="skills-title">
    <div class="wrap">
      <div class="skills-head">
        <div class="section-head">
          <h2 id="skills-title">Skills</h2>
          <p class="lede">
            {totals.frameworkSkills} skills, many of which work without the rest of the framework. Copy a skill into your repository
            and ask your assistant to run it.
          </p>
        </div>
        <fieldset class="segmented" aria-describedby="class-hint">
          <legend class="visually-hidden">Show skills that are</legend>
          <label><input type="radio" name="skill-class" value="all" checked /><span>All {totals.frameworkSkills}</span></label>
          {
            Object.entries(CLASSIFICATION_LABELS).map(([id, c]) => (
              <label>
                <input type="radio" name="skill-class" value={id} />
                <span>
                  {c.name} {countBy(id)}
                </span>
              </label>
            ))
          }
        </fieldset>
      </div>
      <ul class="legend" id="class-hint">
        {
          Object.entries(CLASSIFICATION_LABELS).map(([id, c]) => (
            <li>
              <span class:list={["badge", id]}>{c.name}</span> {c.hint}
            </li>
          ))
        }
      </ul>

      <div class="categories">
        {
          categories.map((cat) => (
            <section class="category" data-category>
              <h3>{cat.name}</h3>
              <ul>
                {cat.skills.map((s) => (
                  <li class="skill" id={`skill-${s.name}`} data-class={s.classification}>
                    <div class="skill-head">
                      <h4>{s.title}</h4>
                      <span class:list={["badge", s.classification]}>{CLASSIFICATION_LABELS[s.classification].name}</span>
                    </div>
                    <p class="summary">{s.summary}</p>
                    {s.whenToInvoke && (
                      <p class="when">
                        <strong>Use it </strong>
                        {s.whenToInvoke}
                      </p>
                    )}
                    <div class="skill-foot">
                      {s.howToInvoke && (
                        <button type="button" class="copy-button" data-copy={s.howToInvoke}>
                          Copy prompt
                        </button>
                      )}
                      <a href={s.source}>Read the skill</a>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section adopt" id="adopt" aria-labelledby="adopt-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="adopt-title">Not ready to onboard? Start with small wins</h2>
        <p class="lede">
          {totals.activities} activities that plug into ceremonies you already run, with nothing to install. Pick two from Phase 1,
          run them for a sprint or two, then add the next.
        </p>
      </div>
      <ol class="phases">
        {
          framework.phases.map((p) => (
            <li class="phase">
              <p class="phase-n">Phase {p.phase}</p>
              <h3>{keepTogether(sentence(p.title))}</h3>
              <p class="phase-intro">{p.intro}</p>
              <ul>
                {p.activities.map((a) => (
                  <li>
                    <p class="activity">{a.activity}</p>
                    <p>{a.does}</p>
                    <p class="toward">Builds toward {lowerFirst(a.buildsToward)}</p>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="start" aria-labelledby="start-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="start-title">Get started</h2>
        <p class="lede">
          Each entry point is a folder you copy from <code>repository-agents/</code> into your project, and one sentence you say to
          your assistant. The content is the same for Claude Code, Cursor and GitHub Copilot.
        </p>
      </div>
      <div class="entries">
        {
          entryPoints.map((e, i) => (
            <article class:list={["entry-point", { primary: i === 0 }]} id={`start-${e.id}`}>
              <h3>{e.title}</h3>
              <p class="muted">{e.when}</p>
              <p class="copy-line">
                Copy{" "}
                {e.copy.map((c, j) => (
                  <>
                    {j > 0 && " and "}
                    <code>{c}</code>
                  </>
                ))}{" "}
                into your project, then say:
              </p>
              <div class="say">
                <pre class="snippet"><code id={`say-${e.id}`}>{e.say}</code></pre>
                <button type="button" class="copy-button" data-copy data-copy-from={`say-${e.id}`}>
                  Copy
                </button>
              </div>
              {e.then && <p class="muted">{e.then}</p>}
            </article>
          ))
        }
      </div>
      <p class="more">
        All guides live in the repository: <a href={framework.url}>{framework.repo}</a>.
      </p>
    </div>
  </section>
</Base>

<script>
  const radios = document.querySelectorAll<HTMLInputElement>('input[name="skill-class"]');
  const skills = document.querySelectorAll<HTMLElement>(".skill");
  const categories = document.querySelectorAll<HTMLElement>("[data-category]");
  function apply() {
    const value = [...radios].find((r) => r.checked)?.value ?? "all";
    skills.forEach((s) => (s.hidden = value !== "all" && s.dataset.class !== value));
    categories.forEach((c) => (c.hidden = [...c.querySelectorAll<HTMLElement>(".skill")].every((s) => s.hidden)));
  }
  radios.forEach((r) => r.addEventListener("change", apply));
  // The browser may restore the chosen radio on reload or Back.
  apply();
  window.addEventListener("pageshow", apply);
</script>

<style>
  .intro {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(3rem, 6vw, 4.5rem);
    background: var(--framework-tint);
    border-bottom: 1px solid var(--rule);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
  }

  @media (max-width: 60rem) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
  }

  .intro-copy {
    display: grid;
    gap: 1.25rem;
  }

  .intro h1 {
    font-size: clamp(2.5rem, 1.5rem + 4vw, 4.25rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .outcome {
    padding: 1.5rem 1.75rem;
    border-radius: var(--radius-m);
    background: var(--surface);
    border: 1px solid color-mix(in srgb, var(--framework-fill) 55%, var(--rule));
  }

  .outcome-title {
    font-family: var(--display);
    font-weight: 650;
    font-size: var(--step-1);
    color: var(--pine);
    margin-bottom: 0.75rem;
  }

  .outcome ul {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .outcome li {
    padding-left: 1rem;
    border-left: 3px solid var(--framework-fill);
  }

  .suite {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--pine);
  }

  .suite-row {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr) minmax(0, 18rem);
    gap: 0.5rem 2rem;
    align-items: baseline;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule);
  }

  @media (max-width: 52rem) {
    .suite-row {
      grid-template-columns: 1fr;
    }
  }

  .suite-name {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .suite-name h3 {
    font-size: var(--step-1);
  }

  .suite-row.core .chip {
    background: var(--framework-tint);
    color: var(--framework);
  }

  .entry {
    display: grid;
    gap: 0.15rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .entry code {
    color: var(--pine);
    overflow-wrap: anywhere;
  }

  .objective {
    background: var(--pine);
    color: var(--on-pine);
    border-top: 0 !important;
  }

  blockquote {
    margin: 0 0 clamp(2.5rem, 6vw, 4rem);
    max-width: 52rem;
  }

  blockquote p {
    font-family: var(--display);
    font-weight: 650;
    font-size: var(--step-3);
    font-variation-settings: "wdth" 85, "opsz" 72;
    line-height: 1.1;
    color: var(--on-pine);
  }

  blockquote footer {
    margin-top: 1rem;
    color: var(--on-pine-muted);
  }

  .forces {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: 2rem clamp(2rem, 5vw, 4rem);
  }

  @media (max-width: 52rem) {
    .forces {
      grid-template-columns: 1fr;
    }
  }

  .forces h3 {
    color: var(--framework-fill);
    font-size: var(--step-1);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--pine-3);
  }

  .forces dl {
    display: grid;
    gap: 1.25rem;
    margin: 1.25rem 0 0;
  }

  .forces dt {
    font-weight: 600;
    color: var(--on-pine);
  }

  .forces dd {
    margin: 0.2rem 0 0;
    color: var(--on-pine-muted);
    font-size: 0.9375rem;
  }

  .values-link {
    margin-top: 2.5rem;
  }

  .values-link a {
    color: var(--on-pine);
  }

  .skills-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
  }

  .skills-head .section-head {
    margin-bottom: 0;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 1.5rem 0 2.5rem;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .badge {
    display: inline-block;
    padding: 0.05rem 0.55rem;
    border-radius: 4px;
    font-size: var(--step--1);
    font-weight: 600;
    white-space: nowrap;
  }

  .badge.standalone {
    background: var(--pine);
    color: var(--on-pine);
  }

  .badge.needs-config {
    background: var(--framework-tint);
    color: var(--framework);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--framework-fill) 60%, transparent);
  }

  .badge.framework-only {
    background: transparent;
    color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  .categories {
    columns: 2 26rem;
    column-gap: clamp(2rem, 5vw, 4rem);
  }

  .category {
    break-inside: avoid;
    margin-bottom: 2.5rem;
  }

  .category > h3 {
    font-size: var(--step-1);
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--pine);
  }

  .category ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill {
    display: grid;
    gap: 0.4rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--rule);
    break-inside: avoid;
    scroll-margin-top: 5.5rem;
    font-size: 0.9375rem;
  }

  .skill:target {
    background: linear-gradient(90deg, var(--framework-tint), transparent 80%);
  }

  .skill-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .skill h4 {
    font-family: var(--display);
    font-size: 1.125rem;
    font-weight: 650;
    color: var(--pine);
  }

  .skill .summary {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .skill .when {
    color: var(--muted);
  }

  .skill .when strong {
    color: var(--pine);
    font-weight: 600;
  }

  .skill-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 0.2rem;
    font-size: var(--step--1);
  }

  .skill-foot a {
    color: var(--muted);
  }

  .adopt {
    background: var(--surface);
  }

  .phases {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 60rem) {
    .phases {
      grid-template-columns: 1fr;
    }
  }

  .phase {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 6px solid color-mix(in srgb, var(--framework-fill) calc(40% + var(--n, 0) * 30%), var(--paper-sunk));
  }

  .phase:nth-child(1) {
    --n: 0;
  }
  .phase:nth-child(2) {
    --n: 1;
  }
  .phase:nth-child(3) {
    --n: 2;
  }

  .phase-n {
    font-weight: 600;
    color: var(--framework);
  }

  .phase h3 {
    font-size: var(--step-2);
  }

  .phase-intro {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .phase ul {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .phase ul li {
    padding: 0.85rem 0;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
  }

  .activity {
    font-weight: 600;
    color: var(--pine);
  }

  .toward {
    margin-top: 0.25rem;
    font-size: var(--step--1);
    color: var(--framework);
  }

  .entries {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  @media (max-width: 52rem) {
    .entries {
      grid-template-columns: 1fr;
    }
  }

  .entry-point {
    display: grid;
    align-content: start;
    gap: 0.85rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--surface);
    min-width: 0;
  }

  .entry-point.primary {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.85rem clamp(1.5rem, 4vw, 3rem);
    border-color: color-mix(in srgb, var(--framework-fill) 60%, var(--rule));
    border-top: 6px solid var(--framework-fill);
  }

  .entry-point.primary > :not(.say, .copy-line) {
    grid-column: 1;
  }

  .entry-point.primary > .copy-line {
    grid-column: 2;
    grid-row: 1;
    align-self: end;
  }

  .entry-point.primary > .say {
    grid-column: 2;
    grid-row: 2 / span 2;
  }

  @media (max-width: 52rem) {
    .entry-point.primary {
      grid-template-columns: 1fr;
    }
    .entry-point.primary > * {
      grid-column: 1 !important;
      grid-row: auto !important;
    }
  }

  .entry-point h3 {
    font-size: var(--step-1);
  }

  .entry-point.primary h3 {
    font-size: var(--step-2);
  }

  .muted {
    color: var(--muted);
  }

  .copy-line {
    font-size: 0.9375rem;
  }

  .say {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .say pre {
    width: 100%;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .more {
    margin-top: 2.5rem;
    color: var(--muted);
  }
</style>
