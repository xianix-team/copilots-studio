---
import Base from "../layouts/Base.astro";
import Ratings from "../components/Ratings.astro";
import { LEVELS, RATINGS, TOOLS, disciplines, expert, levelName, totals } from "../lib/catalog";
import { INSTALL_TOOLS, SCRIPT_FILENAME } from "../lib/install-script";

const byDiscipline = disciplines.map((d) => ({
  ...d,
  agents: expert.agents.filter((a) => a.discipline === d.id).sort((a, b) => a.title.localeCompare(b.title)),
}));

// Agents counted by autonomy (rows, high first) and human judgement (columns, low first).
const rowsHighFirst = [...LEVELS].reverse();
const matrix = rowsHighFirst.map((autonomy) =>
  LEVELS.map((judgement) => ({
    autonomy,
    judgement,
    count: expert.agents.filter((a) => a.autonomy === autonomy && a.humanJudgement === judgement).length,
  })),
);
const busiest = Math.max(...matrix.flat().map((c) => c.count));

// The skill cart builds an install script around the repo's installer, pinned at sync time.
const cart = expert.installer
  ? {
      installer: { url: expert.installer.url, sha256: expert.installer.sha256, commit: expert.installer.commit, repo: expert.repo },
      agents: Object.fromEntries(
        expert.agents.map((a) => [a.name, { title: a.title, discipline: disciplines.find((d) => d.id === a.discipline)?.name ?? "" }]),
      ),
    }
  : null;

const pkg = expert.npmPackage;
const setup = {
  personal: [
    { tool: "Claude Code", file: "Terminal", code: `claude mcp add -s user ide-expert-agents -- npx -y ${pkg}` },
    {
      tool: "Cursor",
      file: "~/.cursor/mcp.json",
      code: JSON.stringify({ mcpServers: { "ide-expert-agents": { command: "npx", args: ["-y", pkg] } } }, null, 2),
    },
    {
      tool: "GitHub Copilot",
      file: ".vscode/mcp.json",
      code: JSON.stringify({ servers: { "ide-expert-agents": { type: "stdio", command: "npx", args: ["-y", pkg] } } }, null, 2),
    },
  ],
  team: [
    {
      tool: "Claude Code",
      file: "Terminal",
      code: "claude mcp add --transport http -s user ide-expert-agents http://your-server:3000/mcp",
    },
    {
      tool: "Cursor",
      file: "~/.cursor/mcp.json",
      code: JSON.stringify({ mcpServers: { "ide-expert-agents": { url: "http://your-server:3000/mcp" } } }, null, 2),
    },
    {
      tool: "GitHub Copilot",
      file: ".vscode/mcp.json",
      code: JSON.stringify({ servers: { "ide-expert-agents": { type: "http", url: "http://your-server:3000/mcp" } } }, null, 2),
    },
  ],
};
const dockerRun = `docker build -t ide-expert-agents-mcp .
docker run -d -p 3000:3000 --name ide-expert-agents ide-expert-agents-mcp`;
---

<Base
  title="IDE Expert Agents"
  current="agents"
  description={`${totals.agents} expert AI agents across ${totals.disciplines} disciplines, served as slash commands in Claude Code, Cursor and GitHub Copilot.`}
>
  <section class="intro">
    <div class="wrap intro-grid">
      <div class="intro-copy">
        <p class="lib agents">IDE Expert Agents</p>
        <h1>A specialist for every task, one command away.</h1>
        <p class="lede">
          {totals.agents} agents that carry a specialist’s method, checklists and standards, from OWASP security scans and WCAG
          audits to PERT estimates and EU AI Act reviews. One MCP server makes them all available in your IDE.
        </p>
        <div class="actions">
          <a class="button" href="#catalog">Browse all {totals.agents} agents</a>
          <a class="button ghost" href="#setup">Set up in your IDE</a>
        </div>
      </div>
      <ol class="how" aria-label="How it works">
        <li>
          <h2>Connect once</h2>
          <p>Add the MCP server to Claude Code, Cursor or GitHub Copilot. Every agent becomes a slash command.</p>
        </li>
        <li>
          <h2>Call an agent</h2>
          <p>Run it by name, or describe the task in agent mode and let your assistant pick the agent.</p>
        </li>
        <li>
          <h2>Review the evidence</h2>
          <p>The agent asks what it needs, follows its method and shows its working. You decide what happens next.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section ratings-map" id="ratings" aria-labelledby="ratings-title">
    <div class="wrap map-layout">
      <div class="map-copy">
        <h2 id="ratings-title">How much the agent does, and how much you decide</h2>
        <p class="lede">
          Every agent rates itself on two scales. Use them to decide how closely to follow its work, and how much expertise to bring
          to what it hands back.
        </p>
        <dl class="scales">
          {
            Object.entries(RATINGS).map(([key, r]) => (
              <div class="scale">
                <dt>
                  <span class:list={["scale-name", key]}>{r.name}</span>
                  <span class="scale-question">{r.question}</span>
                </dt>
                <dd>
                  <ul>
                    {rowsHighFirst.map((l) => (
                      <li>
                        <strong>{levelName(l)}</strong>
                        <span>{r.levels[l]}</span>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <figure class="map">
        <div class="map-grid" role="group" aria-label="Agents by autonomy and human judgement">
          <p class="axis axis-y">Autonomy</p>
          {
            matrix.map((row) => (
              <>
                <p class="row-label">{levelName(row[0].autonomy)}</p>
                {row.map((cell) => (
                  <button
                    type="button"
                    class:list={["cell", { hot: cell.count / busiest > 0.6 }]}
                    style={`--heat: ${cell.count / busiest}`}
                    data-autonomy={cell.autonomy}
                    data-judgement={cell.judgement}
                    disabled={cell.count === 0}
                    aria-label={`${levelName(cell.autonomy)} autonomy, ${cell.judgement} human judgement: ${cell.count} ${cell.count === 1 ? "agent" : "agents"}${cell.count ? ". Show them in the catalog." : ""}`}
                  >
                    <span class="n">{cell.count}</span>
                    <span class="unit">{cell.count === 1 ? "agent" : "agents"}</span>
                  </button>
                ))}
              </>
            ))
          }
          {LEVELS.map((l, i) => <p class="col-label" style={`grid-column: ${i + 3}`}>{levelName(l)}</p>)}
          <p class="axis axis-x">Human judgement</p>
        </div>
        <figcaption>Select a square to see those agents in the catalog.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section catalog" id="catalog" aria-labelledby="catalog-title">
    <div class="wrap">
      <div class="catalog-head">
        <h2 id="catalog-title">The catalog</h2>
        <div class="controls">
          <label class="search">
            <span class="visually-hidden">Search agents</span>
            <input id="agent-search" type="search" placeholder="Search by task, standard or name" autocomplete="off" />
          </label>
          <label class="select">
            <span>Autonomy</span>
            <select id="filter-autonomy">
              <option value="">Any</option>
              {rowsHighFirst.map((l) => <option value={l}>{levelName(l)}</option>)}
            </select>
          </label>
          <label class="select">
            <span>Human judgement</span>
            <select id="filter-judgement">
              <option value="">Any</option>
              {rowsHighFirst.map((l) => <option value={l}>{levelName(l)}</option>)}
            </select>
          </label>
          <fieldset class="segmented">
            <legend class="visually-hidden">Show commands for</legend>
            {
              TOOLS.map((t, i) => (
                <label>
                  <input type="radio" name="agent-tool" value={t.id} checked={i === 0} />
                  <span>{t.name}</span>
                </label>
              ))
            }
          </fieldset>
        </div>
      </div>

      <div class="catalog-body">
        <nav class="filters" aria-label="Disciplines">
          <ul>
            <li>
              <button type="button" class="filter" data-filter="all" aria-pressed="true">
                <span>All disciplines</span><span class="count">{totals.agents}</span>
              </button>
            </li>
            {
              byDiscipline.map((d) => (
                <li>
                  <button type="button" class="filter" data-filter={d.id} aria-pressed="false">
                    <span>{d.name}</span>
                    <span class="count">{d.count}</span>
                  </button>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="groups">
          <div class="result-bar">
            <p class="result-status" aria-live="polite" id="agent-status"></p>
            <button type="button" class="copy-button" id="clear-filters" hidden>Clear filters</button>
          </div>
          {
            byDiscipline.map((d) => (
              <section class="group" id={`discipline-${d.id}`} data-discipline={d.id} aria-labelledby={`h-${d.id}`}>
                <header>
                  <h3 id={`h-${d.id}`}>{d.name}</h3>
                  {d.blurb && <p>{d.blurb}</p>}
                  {cart && (
                    <button type="button" class="add-all" data-cart-group={d.id}>
                      Add all to cart
                    </button>
                  )}
                </header>
                <ul class="agent-list">
                  {d.agents.map((a) => (
                    <li
                      class="agent"
                      id={a.name}
                      data-autonomy={a.autonomy ?? ""}
                      data-judgement={a.humanJudgement ?? ""}
                      data-search={`${a.name} ${a.title} ${d.name} ${a.whenToUse} ${a.description}`.toLowerCase()}
                    >
                      <div class="agent-head">
                        <h4>{a.title}</h4>
                        <Ratings autonomy={a.autonomy} judgement={a.humanJudgement} />
                      </div>
                      <p class="when">{a.whenToUse}</p>
                      <details>
                        <summary>What it does</summary>
                        <p>{a.description}</p>
                      </details>
                      <div class="command">
                        <span class="hint" data-hint>
                          Type
                        </span>
                        <code id={`cmd-${a.name}`} data-name={a.name}>
                          {TOOLS[0].command(a.name)}
                        </code>
                        <button type="button" class="copy-button" data-copy data-copy-from={`cmd-${a.name}`}>
                          Copy
                        </button>
                        <a class="source" href={a.source}>
                          Source
                        </a>
                        {cart && (
                          <button type="button" class="cart-toggle" data-cart-item={a.name} aria-pressed="false">
                            Add to cart
                          </button>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
          <p class="empty" id="agent-empty" hidden>
            No agents match that search. Try a broader word, like “test”, “security” or “design”, or
            <a href="https://github.com/xianix-team/ide-expert-agents/blob/main/CONTRIBUTING.md">propose a new agent</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="setup" aria-labelledby="setup-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="setup-title">Set up in your IDE</h2>
        <p class="lede">
          Pick the setup that fits. Personal setup runs the published package on your machine. A team server runs once and
          everyone connects by URL.
        </p>
        {
          cart && (
            <p class="native-note">
              Prefer skills that live in your repository, with no server? Add them to the cart and download one script that
              installs them as native slash commands for Claude Code, GitHub Copilot or Cursor.
            </p>
          )
        }
      </div>

      <div class="setup">
        <article>
          <h3>Personal setup with npx</h3>
          <p class="muted">Needs Node 18 or later. Nothing to clone or build.</p>
          {
            setup.personal.map((s, i) => (
              <div class="snippet-block">
                <header>
                  <p>
                    {s.tool} <span class="file">{s.file}</span>
                  </p>
                  <button type="button" class="copy-button" data-copy data-copy-from={`personal-${i}`}>
                    Copy
                  </button>
                </header>
                <pre class="snippet"><code id={`personal-${i}`}>{s.code}</code></pre>
              </div>
            ))
          }
        </article>
        <article>
          <h3>Team server with Docker</h3>
          <p class="muted">Build once from the repository root on a shared host, then point each IDE at it.</p>
          <div class="snippet-block">
            <header>
              <p>Shared host <span class="file">Terminal</span></p>
              <button type="button" class="copy-button" data-copy data-copy-from="docker-run">Copy</button>
            </header>
            <pre class="snippet"><code id="docker-run">{dockerRun}</code></pre>
          </div>
          {
            setup.team.map((s, i) => (
              <div class="snippet-block">
                <header>
                  <p>
                    {s.tool} <span class="file">{s.file}</span>
                  </p>
                  <button type="button" class="copy-button" data-copy data-copy-from={`team-${i}`}>
                    Copy
                  </button>
                </header>
                <pre class="snippet"><code id={`team-${i}`}>{s.code}</code></pre>
              </div>
            ))
          }
        </article>
      </div>
      <p class="more">
        Contributing agents or running from a local clone? Follow the <a href={`${expert.url}/blob/main/mcp-server/README.md`}>full setup guide</a>.
      </p>
    </div>
  </section>

  <section class="section contribute" aria-labelledby="contribute-title">
    <div class="wrap contribute-grid">
      <div>
        <h2 id="contribute-title">Add your expertise</h2>
        <p class="lede">
          Every agent is a markdown file, so anyone who knows a method well can package it for everyone else.
        </p>
      </div>
      <ol class="steps">
        <li>Create a folder in the right <code>*-agents-store/</code> with an <code>agent.md</code> that has a name and description.</li>
        <li>Write the method: the questions to ask, the checks to run and the evidence to show.</li>
        <li>Add it to <code>catalog.json</code>, then open a pull request.</li>
      </ol>
      <a class="button" href={`${expert.url}/blob/main/CONTRIBUTING.md`}>Read the contributing guide</a>
    </div>
  </section>

  {
    cart && (
      <>
        <button type="button" class="cart-fab" id="cart-open" hidden aria-haspopup="dialog">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
            <path
              d="M3 4h2l2.4 10.2a1.5 1.5 0 0 0 1.5 1.1h8.3a1.5 1.5 0 0 0 1.5-1.1L20.5 8H6.2"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <circle cx="9.5" cy="19.5" r="1.5" fill="currentColor" />
            <circle cx="17" cy="19.5" r="1.5" fill="currentColor" />
          </svg>
          <span>Cart</span>
          <span class="cart-badge" id="cart-count">0</span>
        </button>
        <p class="visually-hidden" aria-live="polite" id="cart-announce" />

        <dialog class="cart" id="cart" aria-labelledby="cart-title">
          <div class="cart-head">
            <h2 id="cart-title">Your skill cart</h2>
            <form method="dialog">
              <button class="cart-close" aria-label="Close cart">
                <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
                  <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </button>
            </form>
          </div>
          <p class="cart-intro">
            Check out to download one script that installs these skills into your project as native slash commands. No MCP server
            needed.
          </p>

          <section class="cart-block" aria-labelledby="cart-skills-title">
            <h3 id="cart-skills-title">
              Skills <span id="cart-n" />
            </h3>
            <ul class="cart-list" id="cart-list" />
            <p class="cart-empty" id="cart-empty">
              Your cart is empty. Add skills from the catalog, then come back to download the install script.
            </p>
          </section>

          <fieldset class="cart-block">
            <legend>Install for</legend>
            {
              INSTALL_TOOLS.map((t) => (
                <label class="check">
                  <input type="checkbox" name="cart-tool" value={t.id} />
                  <span>
                    {t.name} <code>{t.dir}/</code>
                  </span>
                </label>
              ))
            }
          </fieldset>

          <fieldset class="cart-block">
            <legend>If a skill is already in the project</legend>
            <label class="check">
              <input type="radio" name="cart-replace" value="no" checked />
              <span>Keep the installed copy</span>
            </label>
            <label class="check">
              <input type="radio" name="cart-replace" value="yes" />
              <span>Replace it with the latest version</span>
            </label>
          </fieldset>

          <div class="checkout">
            <button type="button" class="button" id="cart-download">
              Check out and download script
            </button>
            <p class="cart-problem" id="cart-problem" />
            <p class="cart-done" id="cart-done" hidden>
              Downloaded <code>{SCRIPT_FILENAME}</code>.
            </p>
          </div>

          <section class="cart-block run" aria-labelledby="cart-run-title">
            <h3 id="cart-run-title">Then run it</h3>
            <p>From your project folder:</p>
            <div class="say">
              <pre class="snippet"><code id="cart-run">bash {SCRIPT_FILENAME}</code></pre>
              <button type="button" class="copy-button" data-copy data-copy-from="cart-run">
                Copy
              </button>
            </div>
            <p class="muted">
              Or pass the folder: <code>bash {SCRIPT_FILENAME} ~/code/my-project</code>. Needs bash, git and curl. On Windows, use
              Git Bash or WSL. Restart your AI tool afterwards so it picks up the new skills.
            </p>
            <details>
              <summary>Preview the script</summary>
              <pre class="snippet script-preview"><code id="cart-preview" /></pre>
            </details>
          </section>

          <button type="button" class="cart-clear" id="cart-clear">
            Empty the cart
          </button>
        </dialog>
        <script type="application/json" id="cart-data" set:html={JSON.stringify(cart)} />
      </>
    )
  }
</Base>

<script>
  import { TOOLS } from "../lib/tools";

  const search = document.querySelector<HTMLInputElement>("#agent-search")!;
  const byAutonomy = document.querySelector<HTMLSelectElement>("#filter-autonomy")!;
  const byJudgement = document.querySelector<HTMLSelectElement>("#filter-judgement")!;
  const filters = [...document.querySelectorAll<HTMLButtonElement>(".filter")];
  const groups = [...document.querySelectorAll<HTMLElement>(".group")];
  const status = document.querySelector<HTMLElement>("#agent-status")!;
  const empty = document.querySelector<HTMLElement>("#agent-empty")!;
  const toolInputs = document.querySelectorAll<HTMLInputElement>('input[name="agent-tool"]');
  let active = "all";

  const clear = document.querySelector<HTMLButtonElement>("#clear-filters")!;
  const countFor = (id: string) => filters.find((b) => b.dataset.filter === id)?.querySelector<HTMLElement>(".count");

  // Every filter is read from the controls themselves, so the list always matches what they show,
  // including after the browser restores a dropdown's value on reload or Back.
  function apply() {
    const terms = search.value.toLowerCase().split(/\s+/).filter(Boolean);
    const matchesRatingsAndSearch = (agent: HTMLElement) =>
      (!byAutonomy.value || agent.dataset.autonomy === byAutonomy.value) &&
      (!byJudgement.value || agent.dataset.judgement === byJudgement.value) &&
      terms.every((t) => agent.dataset.search!.includes(t));

    let shown = 0;
    let total = 0;
    for (const group of groups) {
      const discipline = group.dataset.discipline!;
      const inDiscipline = active === "all" || discipline === active;
      let available = 0;
      let groupShown = 0;
      for (const agent of group.querySelectorAll<HTMLElement>(".agent")) {
        const match = matchesRatingsAndSearch(agent);
        if (match) available++;
        agent.hidden = !(match && inDiscipline);
        if (!agent.hidden) groupShown++;
      }
      // Discipline counts reflect the search and rating filters, so they never promise agents that aren't there.
      const count = countFor(discipline);
      if (count) count.textContent = String(available);
      filters.find((b) => b.dataset.filter === discipline)?.classList.toggle("none", available === 0);
      group.hidden = groupShown === 0;
      shown += groupShown;
      total += available;
    }
    const all = countFor("all");
    if (all) all.textContent = String(total);

    empty.hidden = shown > 0;
    const filtered = terms.length > 0 || active !== "all" || !!byAutonomy.value || !!byJudgement.value;
    status.textContent = filtered ? `Showing ${shown} of ${groups.reduce((n, g) => n + g.querySelectorAll(".agent").length, 0)} agents` : "";
    clear.hidden = !filtered;
  }

  function selectDiscipline(id: string) {
    active = id;
    filters.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === id)));
  }

  clear.addEventListener("click", () => {
    search.value = "";
    byAutonomy.value = "";
    byJudgement.value = "";
    selectDiscipline("all");
    apply();
  });

  search.addEventListener("input", apply);
  byAutonomy.addEventListener("change", apply);
  byJudgement.addEventListener("change", apply);

  // A square in the map shows its agents: clear other filters, set both ratings, jump to the catalog.
  document.querySelectorAll<HTMLButtonElement>(".cell").forEach((cell) =>
    cell.addEventListener("click", () => {
      search.value = "";
      byAutonomy.value = cell.dataset.autonomy!;
      byJudgement.value = cell.dataset.judgement!;
      selectDiscipline("all");
      apply();
      document.querySelector("#catalog")!.scrollIntoView({ block: "start" });
    }),
  );
  for (const button of filters) {
    button.addEventListener("click", () => {
      selectDiscipline(button.dataset.filter!);
      apply();
      document.querySelector("#catalog")!.scrollIntoView({ block: "start" });
    });
  }

  // Deep links like #discipline-qa-agents-store select that discipline.
  const fromHash = location.hash.match(/^#discipline-(.+)$/);
  if (fromHash && filters.some((b) => b.dataset.filter === fromHash[1])) selectDiscipline(fromHash[1]);

  // Apply whatever the controls hold now. Browsers restore dropdown and search values on reload and Back,
  // sometimes after this script runs, so apply again once the page is shown.
  apply();
  window.addEventListener("pageshow", apply);

  function setTool(id: string) {
    const tool = TOOLS.find((t) => t.id === id) ?? TOOLS[0];
    document.querySelectorAll<HTMLElement>("code[data-name]").forEach((code) => {
      code.textContent = tool.command(code.dataset.name!);
    });
    document.querySelectorAll<HTMLElement>("[data-hint]").forEach((h) => (h.textContent = tool.hint));
    toolInputs.forEach((r) => (r.checked = r.value === tool.id));
    try {
      localStorage.setItem("copilots-tool", tool.id);
    } catch {}
  }
  toolInputs.forEach((r) => r.addEventListener("change", () => setTool(r.value)));
  let saved = "claude";
  try {
    saved = localStorage.getItem("copilots-tool") ?? saved;
  } catch {}
  setTool(saved);
</script>

<script>
  import { INSTALL_TOOLS, SCRIPT_FILENAME, buildInstallScript, type Installer } from "../lib/install-script";

  const dataEl = document.querySelector("#cart-data");
  if (dataEl) {
    const { installer, agents } = JSON.parse(dataEl.textContent!) as {
      installer: Installer;
      agents: Record<string, { title: string; discipline: string }>;
    };
    const STORE = "copilots-cart";
    const dialog = document.querySelector<HTMLDialogElement>("#cart")!;
    const fab = document.querySelector<HTMLButtonElement>("#cart-open")!;
    const count = document.querySelector<HTMLElement>("#cart-count")!;
    const announce = document.querySelector<HTMLElement>("#cart-announce")!;
    const list = document.querySelector<HTMLUListElement>("#cart-list")!;
    const empty = document.querySelector<HTMLElement>("#cart-empty")!;
    const n = document.querySelector<HTMLElement>("#cart-n")!;
    const toolBoxes = [...document.querySelectorAll<HTMLInputElement>('input[name="cart-tool"]')];
    const replaceRadios = [...document.querySelectorAll<HTMLInputElement>('input[name="cart-replace"]')];
    const download = document.querySelector<HTMLButtonElement>("#cart-download")!;
    const problem = document.querySelector<HTMLElement>("#cart-problem")!;
    const done = document.querySelector<HTMLElement>("#cart-done")!;
    const preview = document.querySelector<HTMLElement>("#cart-preview")!;

    type State = { skills: string[]; tools: string[]; replace: boolean };
    let state: State = { skills: [], tools: [], replace: false };
    try {
      const saved = JSON.parse(localStorage.getItem(STORE) ?? "null");
      if (saved && Array.isArray(saved.skills)) state = { skills: saved.skills, tools: saved.tools ?? [], replace: !!saved.replace };
    } catch {}
    // Drop anything no longer in the catalog, e.g. an agent renamed since the cart was saved.
    state.skills = state.skills.filter((s) => s in agents);
    state.tools = state.tools.filter((t) => INSTALL_TOOLS.some((x) => x.id === t));
    if (state.tools.length === 0) {
      let preferred = "claude";
      try {
        preferred = localStorage.getItem("copilots-tool") ?? preferred;
      } catch {}
      state.tools = [INSTALL_TOOLS.some((t) => t.id === preferred) ? preferred : "claude"];
    }

    const save = () => {
      try {
        localStorage.setItem(STORE, JSON.stringify(state));
      } catch {}
    };

    const siteUrl = () => location.origin + location.pathname;
    const script = () =>
      buildInstallScript({ skills: state.skills, tools: state.tools, replaceExisting: state.replace, installer, siteUrl: siteUrl() });

    function render() {
      const k = state.skills.length;
      count.textContent = String(k);
      fab.hidden = k === 0 && !dialog.open;
      fab.setAttribute("aria-label", `Open the skill cart, ${k} ${k === 1 ? "skill" : "skills"}`);
      n.textContent = k ? `(${k})` : "";

      document.querySelectorAll<HTMLButtonElement>("[data-cart-item]").forEach((b) => {
        const inCart = state.skills.includes(b.dataset.cartItem!);
        b.setAttribute("aria-pressed", String(inCart));
        b.textContent = inCart ? "In cart" : "Add to cart";
      });

      list.replaceChildren(
        ...state.skills.map((name) => {
          const li = document.createElement("li");
          const text = document.createElement("div");
          const title = document.createElement("p");
          title.className = "cart-item-title";
          title.textContent = agents[name].title;
          const meta = document.createElement("p");
          meta.className = "cart-item-meta";
          meta.textContent = `${agents[name].discipline}, /${name}`;
          text.append(title, meta);
          const remove = document.createElement("button");
          remove.type = "button";
          remove.className = "cart-remove";
          remove.textContent = "Remove";
          remove.setAttribute("aria-label", `Remove ${agents[name].title} from the cart`);
          remove.addEventListener("click", () => {
            toggle(name, false);
            (list.querySelector<HTMLButtonElement>(".cart-remove") ?? download).focus();
          });
          li.append(text, remove);
          return li;
        }),
      );
      empty.hidden = k > 0;
      toolBoxes.forEach((b) => (b.checked = state.tools.includes(b.value)));
      replaceRadios.forEach((r) => (r.checked = (r.value === "yes") === state.replace));

      const why = k === 0 ? "Add at least one skill to check out." : state.tools.length === 0 ? "Choose at least one tool." : "";
      download.disabled = !!why;
      problem.textContent = why;
      preview.textContent = why ? "" : script();
    }

    function toggle(name: string, on?: boolean) {
      const has = state.skills.includes(name);
      const want = on ?? !has;
      if (want && !has) state.skills.push(name);
      if (!want && has) state.skills = state.skills.filter((s) => s !== name);
      if (want !== has) announce.textContent = `${want ? "Added" : "Removed"} ${agents[name].title}. ${state.skills.length} in cart.`;
      done.hidden = true;
      save();
      render();
    }

    document.querySelectorAll<HTMLButtonElement>("[data-cart-item]").forEach((b) =>
      b.addEventListener("click", () => toggle(b.dataset.cartItem!)),
    );

    // "Add all" adds the agents currently shown in that discipline, so it respects the active filters.
    document.querySelectorAll<HTMLButtonElement>("[data-cart-group]").forEach((b) =>
      b.addEventListener("click", () => {
        const group = document.querySelector<HTMLElement>(`.group[data-discipline="${b.dataset.cartGroup}"]`)!;
        const names = [...group.querySelectorAll<HTMLElement>(".agent:not([hidden])")].map((a) => a.id).filter((x) => x in agents);
        const added = names.filter((x) => !state.skills.includes(x));
        state.skills.push(...added);
        announce.textContent = `Added ${added.length} ${added.length === 1 ? "skill" : "skills"}. ${state.skills.length} in cart.`;
        done.hidden = true;
        save();
        render();
      }),
    );

    toolBoxes.forEach((b) =>
      b.addEventListener("change", () => {
        state.tools = toolBoxes.filter((x) => x.checked).map((x) => x.value);
        save();
        render();
      }),
    );
    replaceRadios.forEach((r) =>
      r.addEventListener("change", () => {
        state.replace = r.value === "yes" && r.checked;
        save();
        render();
      }),
    );

    fab.addEventListener("click", () => {
      dialog.showModal();
      render();
    });
    dialog.addEventListener("close", () => {
      render();
      fab.focus();
    });
    // Clicking the dimmed backdrop closes the cart.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    download.addEventListener("click", () => {
      let text: string;
      try {
        text = script();
      } catch (e) {
        problem.textContent = (e as Error).message;
        return;
      }
      const url = URL.createObjectURL(new Blob([text], { type: "text/x-shellscript" }));
      const a = document.createElement("a");
      a.href = url;
      a.download = SCRIPT_FILENAME;
      document.body.append(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      done.hidden = false;
    });

    document.querySelector("#cart-clear")!.addEventListener("click", () => {
      state.skills = [];
      announce.textContent = "Cart emptied.";
      done.hidden = true;
      save();
      render();
    });

    // #cart in the address opens the cart, so it can be linked to.
    if (location.hash === "#cart" && state.skills.length) dialog.showModal();
    render();
  }
</script>

